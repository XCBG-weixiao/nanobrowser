+    store.acknowledge("admin", notification["id"])
+    store.acknowledge("admin", notification["id"])
+    assert store.pending_notifications("admin") == []
+    assert store.users() == ["1001"]
+
+
+def test_wrong_identity_or_version_does_not_review(store):
+    first, second = application(store), application(store, "1002")
+    with pytest.raises(ReviewConflict):
+        store.review(
+            seq=0,
+            application_id=second["application_id"],
+            expected_version=1,
+            action="approve",
+            actor="admin",
+        )
+    with pytest.raises(ReviewConflict):
+        store.review(
+            application_id=first["application_id"],
+            expected_version=99,
+            action="approve",
+            actor="admin",
+        )
+    assert store.users() == []
