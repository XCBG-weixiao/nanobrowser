+            "INSERT INTO whitelist_reviews VALUES (?,?,?,?,?,?)",
+            (key, row["id"], action, actor, expected_version, at),
+        )
+        if notify:
+            db.execute(
+                "INSERT INTO whitelist_notifications(id,owner,application_id,empl"
+                "oyee_id,kind,message,at) "
