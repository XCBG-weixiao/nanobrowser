+            "SELECT * FROM whitelist_reviews WHERE key=?", (key,)
+        ).fetchone()
+        if prior:
+            if (prior["application_id"], prior["action"], prior["actor"]) != (
+                row["id"],
+                action,
+                actor,
+            ):
+                raise ReviewConflict("idempotency key belongs to a different review")
+            return
+        if row["status"] != "pending" or row["version"] != expected_version:
+            raise ReviewConflict(
+                "application is no longer pending at the expected version"
+            )
+        at = utcnow()
+        status = "approved" if action == "approve" else "rejected"
+        db.execute(
+            "UPDATE whitelist_applications SET status=?,version=version+1,rev"
+            "iewed_by=?,reviewed_at=? WHERE id=?",
+            (status, actor, at, row["id"]),
