+                    key,
+                    actor,
+                    row["id"],
+                    row["employee_id"],
+                    "approved",
+                    f"工号 {row['employee_id']} 的白名单申请已自动通过。",
+                    at,
+                ),
+            )
+
+    def review(
+        self,
+        *,
+        actor: str,
+        action: str,
+        seq: Optional[int] = None,
+        application_id: Optional[str] = None,
+        expected_version: Optional[int] = None,
+        key: Optional[str] = None,
+    ) -> Dict[str, Any]:
+        if action not in {"approve", "reject"}:
+            raise ValueError("action must be approve or reject")
+        with self.transaction() as db:
+            row = db.execute(
+                "SELECT * FROM whitelist_applications WHERE "
+                + ("id=?" if application_id else "seq=?"),
+                (application_id if application_id else seq,),
+            ).fetchone()
+            if row is None:
+                raise IndexError("application not found")
+            if seq is not None and row["seq"] != seq:
+                raise ReviewConflict("application id does not match its index")
+            self._review(
+                db,
+                row,
+                action,
+                actor,
+                key or str(uuid4()),
+                expected_version if expected_version is not None else row["version"],
+            )
+        return {**self.payload(), "users": self.users()}
+
+    def watch(self) -> Dict[str, Any]:
+        with self.transaction() as db:
+            result = dict(
+                db.execute("SELECT * FROM whitelist_watch WHERE id=1").fetchone()
+            )
+            result["enabled"] = bool(result["enabled"])
+            result["pending_count"] = db.execute(
+                "SELECT COUNT(*) FROM whitelist_applications WHERE status='pending'"
+            ).fetchone()[0]
+            result["approved_count"] = db.execute(
+                "SELECT COUNT(*) FROM whitelist_reviews WHERE key LIKE 'auto:%'"
+            ).fetchone()[0]
+            result["recent"] = [
+                dict(r)
+                for r in db.execute(
+                    "SELECT * FROM whitelist_notifications ORDER BY at DESC LIMIT 20"
+                )
+            ]
+            return result
+
+    def set_watch(self, enabled: bool, owner: str) -> Dict[str, Any]:
+        with self.transaction() as db:
+            db.execute(
+                "UPDATE whitelist_watch SET enabled=?,owner=?,next_run=0,error=NU"
+                "LL,updated_at=? WHERE id=1",
+                (int(enabled), owner, utcnow()),
+            )
+        return self.watch()
+
+    def run_due(self, is_admin: Callable[[str], bool], now: float) -> int:
+        with self.transaction() as db:
