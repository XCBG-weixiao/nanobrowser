+"""One bounded, model-free poller; SQLite serializes competing server processes."""
+
+import asyncio
+import logging
+import time
+from typing import Optional
+
+from dbgpt_serve.utils.user_auth import get_user_auth_store
+
+logger = logging.getLogger(__name__)
+
+
+def authorized_admin(owner: str) -> bool:
+    user = get_user_auth_store().get_user(owner)
+    return user is not None and user.role == "admin"
+
+
+class WhitelistWatchService:
+    def __init__(self):
+        self.task: Optional[asyncio.Task] = None
+        self.wake = asyncio.Event()
+        self.last_error: Optional[str] = None
+
+    async def start(self) -> None:
+        if self.task is None:
+            self.task = asyncio.create_task(self._run(), name="expert-whitelist-watch")
+
+    async def stop(self) -> None:
+        if self.task is not None:
+            self.task.cancel()
+            try:
+                await self.task
+            except asyncio.CancelledError:
+                pass
+            self.task = None
+
+    async def _run(self) -> None:
+        from .agentic_data_api import expert_mode_store
+
+        while True:
+            self.wake.clear()
+            try:
+                await asyncio.to_thread(
+                    lambda: expert_mode_store().run_due(authorized_admin, time.time())
+                )
+                self.last_error = None
+            except Exception:
+                self.last_error = "自动审批检查失败，请查看服务器日志。"
+                logger.exception("Expert whitelist watch failed")
+            try:
+                await asyncio.wait_for(self.wake.wait(), timeout=30)
+            except asyncio.TimeoutError:
+                pass
+
+
+whitelist_watch_service = WhitelistWatchService()
+
+
+def register_whitelist_watch(app) -> None:
+    """Use DB-GPT's lifecycle registry, including its custom FastAPI lifespan."""
+    from dbgpt.util.fastapi import register_event_handler
+
+    register_event_handler(app, "startup", whitelist_watch_service.start)
+    register_event_handler(app, "shutdown", whitelist_watch_service.stop)
