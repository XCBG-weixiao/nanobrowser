+import json
+from concurrent.futures import ThreadPoolExecutor
+
+import pytest
+
+from dbgpt_app.openapi.api_v1.expert_whitelist_store import (
+    ExpertWhitelistStore,
+    ReviewConflict,
+)
+
+
+@pytest.fixture
+def store(tmp_path):
+    return ExpertWhitelistStore(
+        tmp_path / "state.sqlite3",
+        tmp_path / "applications.json",
+        tmp_path / "users.json",
+    )
+
+
+def application(store, employee="1001"):
+    return store.append(
+        {
+            "employee_id": employee,
+            "department": "数据部",
+            "created_at": "2026-11-02T01:00:00Z",
+        }
+    )
+
+
+def test_import_is_once_and_preserves_revocation(tmp_path):
+    apps, users = tmp_path / "applications.json", tmp_path / "users.json"
+    original = [{"employee_id": "1001", "status": "approved"}, {"employee_id": "1002"}]
+    apps.write_text(json.dumps(original))
+    users.write_text('["1002"]')
+    first = ExpertWhitelistStore(tmp_path / "state.sqlite3", apps, users)
+    rows = first.applications()
+    assert [r["status"] for r in rows] == ["revoked", "approved"]
+    reopened = ExpertWhitelistStore(first.path, apps, users)
+    assert reopened.applications() == rows
+    assert json.loads(apps.read_text()) == original
+
+
+def test_existing_and_new_applications_are_processed_once_after_restart(store):
+    first = application(store)
+    store.set_watch(True, "admin")
+    assert store.run_due(lambda _: True, 100) == 1
+    assert store.run_due(lambda _: True, 101) == 0
+    second = application(store, "1002")
+    reopened = ExpertWhitelistStore(
+        store.path,
+        store.path.parent / "applications.json",
+        store.path.parent / "users.json",
+    )
+    assert reopened.run_due(lambda _: True, 130) == 1
+    assert reopened.users() == ["1001", "1002"]
+    notifications = reopened.pending_notifications("admin")
+    assert {n["application_id"] for n in notifications} == {
+        first["application_id"],
+        second["application_id"],
+    }
+    assert reopened.run_due(lambda _: True, 160) == 0
+    assert len(reopened.pending_notifications("admin")) == 2
+
+
+def test_all_submissions_are_processed_including_same_employee(store):
+    for _ in range(3):
+        application(store)
+    assert len(store.payload()["applications"]) == 1
+    store.set_watch(True, "admin")
+    assert store.run_due(lambda _: True, 0) == 3
+    assert len(store.pending_notifications("admin")) == 3
+
+
+def test_manual_rejection_and_revocation_are_not_overwritten(store):
+    rejected = application(store)
+    store.review(seq=0, action="reject", actor="admin")
+    approved = application(store, "1002")
+    store.review(seq=1, action="approve", actor="admin")
+    store.remove_user("1002")
+    with pytest.raises(ReviewConflict):
+        store.review(
+            seq=0,
+            application_id=rejected["application_id"],
+            expected_version=1,
+            action="approve",
+            actor="admin",
+        )
+    with pytest.raises(ReviewConflict):
+        store.review(
+            seq=1,
+            application_id=approved["application_id"],
+            expected_version=1,
+            action="approve",
+            actor="admin",
+        )
+    store.set_watch(True, "admin")
+    assert store.run_due(lambda _: True, 0) == 0
+    assert store.users() == []
+
+
+def test_review_idempotency_does_not_grant_again_after_revocation(store):
+    item = application(store)
+    args = dict(
+        application_id=item["application_id"],
+        expected_version=1,
+        action="approve",
+        actor="admin",
+        key="operation-1",
+    )
+    store.review(**args)
+    store.remove_user("1001")
+    store.review(**args)
+    assert store.users() == []
+    assert store.applications()[0]["status"] == "revoked"
+    with pytest.raises(ReviewConflict):
+        store.review(**{**args, "action": "reject"})
+
+
+def test_outbox_failure_rolls_back_grant_review_and_task_state(store):
+    application(store)
+    store.set_watch(True, "admin")
+    with store.transaction() as db:
+        db.execute(
+            "CREATE TRIGGER fail_outbox BEFORE INSERT ON whitelist_notificati"
+            "ons BEGIN SELECT RAISE(ABORT,'injected'); END"
+        )
+    with pytest.raises(Exception, match="injected"):
+        store.run_due(lambda _: True, 0)
+    assert store.users() == []
+    assert store.applications()[0]["status"] == "pending"
+    assert store.watch()["approved_count"] == 0
+    assert store.watch()["checked_at"] is None
+
+
+def test_competing_pollers_have_one_effect_per_application(store):
+    for index in range(100):
+        application(store, str(index))
+    store.set_watch(True, "admin")
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        results = list(
+            pool.map(lambda _: store.run_due(lambda _owner: True, 100), range(2))
+        )
+    assert sorted(results) == [0, 100]
+    assert len(store.users()) == 100
+    assert store.watch()["approved_count"] == 100
+
+
+def test_pause_and_authorizer_revocation_prevent_writes(store):
+    application(store)
+    store.set_watch(False, "admin")
+    assert store.run_due(lambda _: True, 0) == 0
