+"""Transactional whitelist approvals and notification outbox."""
+
+import json
+import sqlite3
+from contextlib import contextmanager
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any, Callable, Dict, List, Optional
+from uuid import uuid4
+
+
+class ReviewConflict(ValueError):
+    """The application changed before the requested review could commit."""
+
+
+def utcnow() -> str:
+    return datetime.now(timezone.utc).isoformat()
+
+
+class ExpertWhitelistStore:
+    def __init__(self, path: Path, applications: Path, whitelist: Path):
+        self.path = path
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        with self.transaction() as db:
+            db.executescript(
+                """
+                CREATE TABLE IF NOT EXISTS whitelist_meta (
+                    key TEXT PRIMARY KEY, value TEXT NOT NULL
+                );
+                CREATE TABLE IF NOT EXISTS whitelist_users (
+                    employee_id TEXT PRIMARY KEY
+                );
+                CREATE TABLE IF NOT EXISTS whitelist_applications (
+                    seq INTEGER PRIMARY KEY,
+                    id TEXT NOT NULL UNIQUE,
+                    employee_id TEXT NOT NULL,
+                    payload TEXT NOT NULL,
+                    status TEXT NOT NULL,
+                    version INTEGER NOT NULL DEFAULT 1,
+                    reviewed_by TEXT,
+                    reviewed_at TEXT
+                );
+                CREATE TABLE IF NOT EXISTS whitelist_reviews (
+                    key TEXT PRIMARY KEY,
+                    application_id TEXT NOT NULL,
+                    action TEXT NOT NULL,
+                    actor TEXT NOT NULL,
+                    version INTEGER NOT NULL,
+                    at TEXT NOT NULL
+                );
+                CREATE TABLE IF NOT EXISTS whitelist_watch (
+                    id INTEGER PRIMARY KEY CHECK(id=1),
+                    enabled INTEGER NOT NULL DEFAULT 0,
+                    owner TEXT,
+                    next_run REAL NOT NULL DEFAULT 0,
+                    checked_at TEXT,
+                    error TEXT,
+                    updated_at TEXT NOT NULL
+                );
+                CREATE TABLE IF NOT EXISTS whitelist_notifications (
+                    id TEXT PRIMARY KEY,
+                    owner TEXT NOT NULL,
+                    application_id TEXT,
+                    employee_id TEXT,
+                    kind TEXT NOT NULL,
+                    message TEXT NOT NULL,
+                    at TEXT NOT NULL,
+                    acknowledged_at TEXT
+                );
+                CREATE INDEX IF NOT EXISTS whitelist_pending
+                    ON whitelist_applications(status, seq);
+                CREATE INDEX IF NOT EXISTS whitelist_outbox
+                    ON whitelist_notifications(owner, acknowledged_at, at);
+                """
+            )
+        # Import once, in one transaction. The old files remain available for an
+        # operator's backup.
+        with self.transaction() as db:
+            if db.execute(
+                "SELECT 1 FROM whitelist_meta WHERE key='imported'"
+            ).fetchone():
+                return
+            users = self._legacy(whitelist)
+            if any(not isinstance(user, str) or not user.strip() for user in users):
+                raise ValueError("legacy whitelist must contain nonempty employee ids")
+            users = {user.strip() for user in users}
+            db.executemany(
+                "INSERT INTO whitelist_users VALUES (?)", [(u,) for u in sorted(users)]
+            )
+            for seq, item in enumerate(self._legacy(applications)):
+                if (
+                    not isinstance(item, dict)
+                    or not str(item.get("employee_id") or "").strip()
+                ):
+                    raise ValueError("legacy applications must contain employee ids")
+                employee = str(item["employee_id"]).strip()
+                status = item.get("status", "pending")
+                if status not in {"pending", "approved", "rejected", "revoked"}:
+                    raise ValueError("invalid legacy application status")
+                if employee in users:
+                    status = "approved"
+                elif status == "approved":
+                    status = "revoked"
+                db.execute(
+                    "INSERT INTO whitelist_applications(seq,id,employee_id,payload,st"
+                    "atus,reviewed_by,reviewed_at) "
+                    "VALUES (?,?,?,?,?,?,?)",
+                    (
+                        seq,
+                        str(uuid4()),
+                        employee,
+                        json.dumps(item, ensure_ascii=False),
+                        status,
+                        item.get("reviewed_by"),
+                        item.get("reviewed_at"),
+                    ),
+                )
+            db.execute(
+                "INSERT INTO whitelist_watch(id,updated_at) VALUES (1,?)", (utcnow(),)
+            )
+            db.execute("INSERT INTO whitelist_meta VALUES ('imported',?)", (utcnow(),))
+
+    @staticmethod
+    def _legacy(path: Path) -> List[Any]:
+        if not path.exists():
+            return []
+        result = json.loads(path.read_text(encoding="utf-8"))
+        if not isinstance(result, list):
+            raise ValueError(f"{path.name} must be a JSON array")
+        return result
+
+    @contextmanager
+    def transaction(self):
+        db = sqlite3.connect(str(self.path), timeout=10, isolation_level=None)
+        db.row_factory = sqlite3.Row
+        try:
+            db.execute("PRAGMA foreign_keys=ON")
+            db.execute("BEGIN IMMEDIATE")
+            yield db
+            db.commit()
+        except BaseException:
+            db.rollback()
+            raise
+        finally:
+            db.close()
+
+    @staticmethod
+    def _item(row: sqlite3.Row) -> Dict[str, Any]:
+        return {
+            **json.loads(row["payload"]),
+            "application_index": row["seq"],
+            "application_id": row["id"],
+            "version": row["version"],
+            "status": row["status"],
+            "reviewed_by": row["reviewed_by"],
+            "reviewed_at": row["reviewed_at"],
+        }
+
+    def users(self) -> List[str]:
+        with self.transaction() as db:
+            return [
+                row[0]
+                for row in db.execute(
+                    "SELECT employee_id FROM whitelist_users ORDER BY employee_id"
+                )
+            ]
+
+    @staticmethod
+    def _add_user(db: sqlite3.Connection, employee: str) -> None:
+        db.execute("INSERT OR IGNORE INTO whitelist_users VALUES (?)", (employee,))
+
+    @staticmethod
+    def _remove_user(db: sqlite3.Connection, employee: str) -> None:
+        db.execute("DELETE FROM whitelist_users WHERE employee_id=?", (employee,))
+        db.execute(
+            "UPDATE whitelist_applications SET status='revoked',version=version+1 "
+            "WHERE employee_id=? AND status IN ('approved','pending')",
+            (employee,),
+        )
+
+    def replace_users(self, users: List[str]) -> List[str]:
+        with self.transaction() as db:
+            old = {
+                row[0] for row in db.execute("SELECT employee_id FROM whitelist_users")
+            }
+            for employee in old - set(users):
+                self._remove_user(db, employee)
+            for employee in set(users) - old:
+                self._add_user(db, employee)
+                db.execute(
+                    "UPDATE whitelist_applications SET status='approved',version=vers"
+                    "ion+1 "
+                    "WHERE employee_id=? AND status='pending'",
+                    (employee,),
+                )
+        return self.users()
+
+    def add_user(self, employee: str) -> List[str]:
+        with self.transaction() as db:
+            self._add_user(db, employee)
+            db.execute(
+                "UPDATE whitelist_applications SET status='approved',version=version+1 "
+                "WHERE employee_id=? AND status='pending'",
+                (employee,),
+            )
+        return self.users()
+
+    def remove_user(self, employee: str) -> List[str]:
+        with self.transaction() as db:
+            self._remove_user(db, employee)
+        return self.users()
+
+    def append(self, record: Dict[str, Any]) -> Dict[str, Any]:
+        with self.transaction() as db:
+            seq = db.execute(
+                "SELECT COALESCE(MAX(seq),-1)+1 FROM whitelist_applications"
+            ).fetchone()[0]
+            db.execute(
+                "INSERT INTO whitelist_applications(seq,id,employee_id,payload,st"
+                "atus) VALUES (?,?,?,?,'pending')",
+                (
+                    seq,
+                    str(uuid4()),
+                    record["employee_id"],
+                    json.dumps(record, ensure_ascii=False),
+                ),
+            )
+            return self._item(
+                db.execute(
+                    "SELECT * FROM whitelist_applications WHERE seq=?", (seq,)
+                ).fetchone()
+            )
+
+    def applications(self, latest: bool = False) -> List[Dict[str, Any]]:
+        with self.transaction() as db:
+            query = "SELECT * FROM whitelist_applications"
+            if latest:
+                query += (
+                    " WHERE seq IN (SELECT MAX(seq) FROM whitelist_applications GROUP"
+                    " BY employee_id)"
+                )
+            return [
+                self._item(row)
+                for row in db.execute(
+                    query + " ORDER BY seq DESC" if latest else query + " ORDER BY seq"
+                )
+            ]
+
+    def payload(self) -> Dict[str, Any]:
+        applications = self.applications(latest=True)
+        return {
+            "applications": applications,
+            "pending_count": sum(a["status"] == "pending" for a in applications),
+        }
